# ============================================================
# Variables de Entorno - Servidor Backend
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real a GitHub.
# ============================================================

# Puerto del servidor Express (opcional en Vercel)
PORT=5000

# Entorno: development | production
NODE_ENV=development

# Clave secreta para firmar tokens JWT (usa una clave larga y aleatoria)
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA_LARGA

# URL de la base de datos PostgreSQL
# - Local (dev): obtener de Neon, Supabase u otro proveedor
# - Producción (Vercel): configurar en Vercel Dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# URL del frontend (para CORS en producción)
# Ejemplo: https://tu-proyecto.vercel.app
FRONTEND_URL=https://tu-proyecto.vercel.app
